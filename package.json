{
  "name": "overclocked",
  "version": "0.1.0",
  "description": "High-throughput, real-time telemetry & data processing pipeline CLI for F1-style motorsport sensor streams.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
